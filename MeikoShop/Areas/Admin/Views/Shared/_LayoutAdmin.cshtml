<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard Meiko Shop Manager</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- PagedList CSS (if any) -->
    <link href="~/Content/PagedList.css" rel="stylesheet" />

    <style>
        :root {
            --sidebar-width: 250px;
            --bg-color: #0f172a;
            --surface: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
            --primary: #6366f1;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Be Vietnam Pro', sans-serif;
        }

        /* Override MVC inputs */
        input, select, textarea {
            max-width: 100% !important;
        }

        /* Layout Structure */
        #wrapper {
            display: flex;
            width: 100%;
            align-items: stretch;
            min-height: 100vh;
        }

        #sidebar {
            min-width: var(--sidebar-width);
            max-width: var(--sidebar-width);
            background-color: var(--surface);
            transition: all 0.3s;
            border-right: 1px solid rgba(255,255,255,0.05);
        }

        #sidebar.collapsed {
            margin-left: calc(-1 * var(--sidebar-width));
        }

        .sidebar-header {
            padding: 20px;
            background: rgba(0,0,0,0.2);
            text-align: center;
        }

        .sidebar-menu a {
            padding: 15px 20px;
            font-size: 1.1em;
            display: block;
            color: var(--text-muted);
            text-decoration: none;
            transition: 0.2s;
            border-left: 3px solid transparent;
        }

        .sidebar-menu a:hover, .sidebar-menu a.active {
            color: var(--primary);
            background: rgba(255,255,255,0.02);
            border-left-color: var(--primary);
        }

        #content-wrapper {
            width: 100%;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        /* Top Navbar */
        .top-navbar {
            background-color: var(--surface) !important;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            padding: 10px 20px;
        }

        /* Cards & Tables */
        .card {
            background-color: var(--surface);
            border: 1px solid rgba(255,255,255,0.05);
        }

        .table {
            color: var(--text-main);
        }
        
        .table th {
            color: var(--text-muted);
            font-weight: 600;
        }

        /* Footer */
        .footer {
            background-color: var(--surface);
            padding: 20px;
            text-align: center;
            border-top: 1px solid rgba(255,255,255,0.05);
            margin-top: auto;
        }

        /* Fix ASP.NET ActionLink */
        .sidebar-menu a {
            display: flex;
            align-items: center;
            gap: 10px;
        }
    </style>
</head>
<body>
    @{ var u = Session["use"] as MeikoShop.Models.Nguoidung; }

    <div id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar">
            <div class="sidebar-header">
                <h4 class="m-0 text-uppercase fw-bold" style="color: var(--primary);">
                    <i class="fa-solid fa-dragon me-2"></i>Meiko Admin
                </h4>
            </div>

            <div class="sidebar-menu mt-3">
                <div class="px-3 mb-2 text-uppercase text-muted small fw-bold">Quản lý cửa hàng</div>
                
                <a href="@Url.Action("Index", "Home", new { area = "Admin" })">
                    <i class="fa-solid fa-box w-20px"></i> Sản phẩm
                </a>
                <a href="@Url.Action("Index", "Hangsanxuats", new { area = "Admin" })">
                    <i class="fa-solid fa-industry w-20px"></i> Hãng sản xuất
                </a>
                <a href="@Url.Action("Index", "Chatlieu", new { area = "Admin" })">
                    <i class="fa-solid fa-layer-group w-20px"></i> Chất liệu
                </a>
                
                <div class="px-3 mb-2 mt-4 text-uppercase text-muted small fw-bold">Hệ thống</div>

                <a href="@Url.Action("Index", "Donhangs", new { area = "Admin" })">
                    <i class="fa-solid fa-cart-shopping w-20px"></i> Đơn hàng
                </a>
                <a href="@Url.Action("Index", "Nguoidungs", new { area = "Admin" })">
                    <i class="fa-solid fa-users w-20px"></i> Người dùng
                </a>
                <a href="@Url.Action("Index", "Thongkes", new { area = "Admin" })">
                    <i class="fa-solid fa-chart-line w-20px"></i> Thống kê
                </a>
            </div>
        </nav>

        <!-- Content Wrapper -->
        <div id="content-wrapper">
            <!-- Top Navbar -->
            <nav class="navbar navbar-expand-lg top-navbar">
                <div class="container-fluid">
                    <button type="button" id="sidebarCollapse" class="btn btn-outline-secondary border-0">
                        <i class="fas fa-bars"></i>
                    </button>

                    <div class="ms-auto d-flex align-items-center">
                        <div class="dropdown">
                            <a class="nav-link dropdown-toggle text-white d-flex align-items-center gap-2" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="@(u != null && !string.IsNullOrEmpty(u.Anhdaidien) ? Url.Content("~" + u.Anhdaidien) : "https://ui-avatars.com/api/?name=Admin&background=6366f1&color=fff")" class="rounded-circle" width="35" height="35" style="object-fit:cover;" />
                                <span>@(u != null ? u.Hoten : "Admin")</span>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">
                                <li>
                                    <a class="dropdown-item" href="@(u != null ? Url.Action("Details", "Nguoidungs", new { id = u.MaNguoiDung, area = "Admin" }) : "#")">
                                        <i class="fa-solid fa-user me-2"></i> Hồ sơ cá nhân
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="@Url.Action("ChangePassword", "Nguoidungs", new { area = "Admin" })">
                                        <i class="fa-solid fa-key me-2"></i> Đổi mật khẩu
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item text-danger" href="/User/DangXuat">
                                        <i class="fa-solid fa-sign-out-alt me-2"></i> Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Main Content -->
            <main class="container-fluid py-4 flex-grow-1">
                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer">
                <div class="container-fluid">
                    <div class="d-flex align-items-center justify-content-between small text-muted">
                        <div>&copy; 2026 MeikoShop Premium. All rights reserved.</div>
                        <div>
                            <a href="#" class="text-muted text-decoration-none me-3">Chính sách bảo mật</a>
                            <a href="#" class="text-muted text-decoration-none">Điều khoản sử dụng</a>
                        </div>
                    </div>
                </div>
            </footer>
        </div>
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

    <!-- Sidebar Toggle Script -->
    <script>
        $(document).ready(function () {
            $('#sidebarCollapse').on('click', function () {
                $('#sidebar').toggleClass('collapsed');
            });
            
            // Highlight active menu
            var currentUrl = window.location.pathname;
            $('.sidebar-menu a').each(function() {
                if ($(this).attr('href') === currentUrl) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
</body>
</html>
