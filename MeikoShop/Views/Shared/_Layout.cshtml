<!DOCTYPE html>
<html lang="vi" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewBag.Title - MeikoShop Premium Figure</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")
    
    <!-- Google Fonts for Modern Look (Vietnamese Support) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;600;800&family=Inter:wght@400;500;700&display=swap" rel="stylesheet">
    
    <!-- Bootstrap 5 CSS (Load via CDN to avoid local NuGet conflicts) -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <script src="~/Scripts/jquery-3.4.1.min.js"></script>
    <script src="~/Scripts/jquery.unobtrusive-ajax.min.js"></script>

    <style type="text/css">
        :root {
            --primary: #6366f1;
            --secondary: #ec4899;
            --bg-color: #0f172a;
            --surface: #1e293b;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
            padding-top: 80px; /* Space for fixed navbar */
        }

        h1, h2, h3, h4, h5, h6, .navbar-brand {
            font-family: 'Be Vietnam Pro', sans-serif;
            font-weight: 800;
        }

        /* Fix text colors for custom dark theme */
        .text-muted {
            color: var(--text-muted) !important;
        }
        
        .text-main {
            color: var(--text-main) !important;
        }

        /* Override ASP.NET MVC Default max-width for inputs */
        input, select, textarea {
            max-width: 100% !important;
        }

        /* Glassmorphism Navbar */
        .navbar-glass {
            background: rgba(15, 23, 42, 0.8) !important;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.1);
            transition: all 0.3s ease;
        }

        .navbar-brand {
            background: linear-gradient(to right, var(--primary), var(--secondary));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-size: 1.8rem;
        }

        .nav-link {
            color: var(--text-main) !important;
            font-weight: 500;
            transition: color 0.3s ease;
            position: relative;
        }
        
        .nav-link:hover {
            color: var(--secondary) !important;
        }

        .nav-link::after {
            content: '';
            position: absolute;
            width: 0;
            height: 2px;
            bottom: 0;
            left: 0;
            background-color: var(--secondary);
            transition: width 0.3s ease;
        }

        .nav-link:hover::after {
            width: 100%;
        }

        /* Premium Cards */
        .glass-card {
            background: var(--surface);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
        }

        .glass-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
            border-color: rgba(236, 72, 153, 0.3);
        }

        .card-img-wrapper {
            position: relative;
            overflow: hidden;
            padding-top: 100%; /* 1:1 Aspect Ratio */
        }
        
        .card-img-wrapper img {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.6s ease;
        }

        .glass-card:hover .card-img-wrapper img {
            transform: scale(1.1);
        }

        /* Animated Buttons */
        .btn-gradient {
            background: linear-gradient(45deg, var(--primary), var(--secondary));
            color: white;
            border: none;
            border-radius: 8px;
            padding: 10px 24px;
            font-weight: 600;
            transition: all 0.3s ease;
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        .btn-gradient::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(45deg, var(--secondary), var(--primary));
            z-index: -1;
            transition: opacity 0.3s ease;
            opacity: 0;
        }

        .btn-gradient:hover::before {
            opacity: 1;
        }
        
        .btn-gradient:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(236, 72, 153, 0.4);
            color: white;
        }

        /* Gradient Text */
        .text-gradient {
            background: linear-gradient(to right, #38bdf8, #818cf8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .text-price {
            color: #fb7185 !important;
            font-weight: 800;
            font-size: 1.25rem;
        }

        /* Footer */
        .footer-glass {
            background: var(--surface);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
            padding: 40px 0;
            margin-top: 60px;
        }
    </style>
</head>
<body>
    @{ var u = Session["use"] as MeikoShop.Models.Nguoidung; }

    <!-- Navbar Bootstrap 5 -->
    <nav class="navbar navbar-expand-lg navbar-glass fixed-top">
        <div class="container">
            <a class="navbar-brand d-flex align-items-center gap-2" href="@Url.Action("Index", "Home", new { area = "" })">
                <i class="fa-solid fa-dragon"></i> MeikoShop
            </a>
            
            <button class="navbar-toggler border-0 text-white" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars fs-3"></i>
            </button>

            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 fs-5 gap-3">
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "Home")"><i class="fa-solid fa-house-chimney"></i> Trang chủ</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Index", "DonHangs")"><i class="fa-solid fa-box-open"></i> Đơn hàng</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="@Url.Action("Contact", "Home")"><i class="fa-solid fa-headset"></i> Liên hệ</a>
                    </li>
                </ul>

                <div class="d-flex align-items-center gap-4">
                    <!-- Giỏ hàng Partial -->
                    <div class="cart-wrapper position-relative">
                        @Html.Action("GioHangPartial", "GioHang")
                    </div>
                    
                    <!-- Auth Section -->
                    <div class="auth-section d-flex gap-3">
                        @if (u != null)
                        {
                            <div class="dropdown">
                                <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle gap-2" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                    <img src="https://ui-avatars.com/api/?name=@u.Email&background=6366f1&color=fff&rounded=true" alt="User" width="35" height="35">
                                    <span class="fw-semibold">@u.Email</span>
                                </a>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow-lg border-0" aria-labelledby="userMenu">
                                    <li><a class="dropdown-item py-2" href="@Url.Action("Profile", "User", new { id = u.MaNguoiDung })"><i class="fa-solid fa-id-badge me-2"></i> Hồ sơ</a></li>
                                    <li><hr class="dropdown-divider border-secondary"></li>
                                    <li><a class="dropdown-item py-2 text-danger fw-bold" href="/User/DangXuat"><i class="fa-solid fa-right-from-bracket me-2"></i> Đăng xuất</a></li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a href="/User/Dangnhap" class="btn btn-outline-light rounded-pill px-4">Đăng nhập</a>
                            <a href="/User/Dangky" class="btn btn-gradient rounded-pill px-4">Đăng ký</a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container min-vh-100 pb-5">
        @RenderBody()
        
        <!-- Footer Banner (ban2.jpg) -->
        <div class="mt-5 text-center">
            <div class="glass-card d-inline-block overflow-hidden shadow w-100">
                <img class="img-fluid w-100" src="~/ELMImages/ban2.jpg" alt="Footer Banner" />
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="footer-glass text-center text-md-start">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6 mb-3 mb-md-0 text-center text-md-start">
                    <h4 class="navbar-brand mb-1">MeikoShop</h4>
                    <p class="text-muted mb-0">Thiên đường mô hình Figure cao cấp số 1 Việt Nam</p>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <div class="fs-4 d-flex justify-content-center justify-content-md-end gap-3 text-muted">
                        <a href="#" class="text-muted text-decoration-none hover-white"><i class="fa-brands fa-facebook"></i></a>
                        <a href="#" class="text-muted text-decoration-none hover-white"><i class="fa-brands fa-instagram"></i></a>
                        <a href="#" class="text-muted text-decoration-none hover-white"><i class="fa-brands fa-youtube"></i></a>
                    </div>
                    <p class="text-muted mt-2 mb-0 small">&copy; @DateTime.Now.Year Bản quyền thuộc về MeikoShop. All rights reserved.</p>
                </div>
            </div>
        </div>
    </footer>

    <!-- Bootstrap 5 JS Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
