@model MeikoShop.Models.LoginModel

@{
    ViewBag.Title = "Đăng nhập";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="row justify-content-center align-items-center min-vh-100" style="margin-top: -80px;">
    <div class="col-md-6 col-lg-5">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="fa-solid fa-dragon fa-3x text-gradient mb-3"></i>
                <h2 class="fw-bold text-white">Chào mừng trở lại!</h2>
                <p class="text-muted">Đăng nhập để khám phá vũ trụ mô hình</p>
            </div>

            @if (ViewBag.Fail != null)
            {
                <div class="alert alert-danger bg-danger bg-opacity-10 border-danger text-danger rounded-3" role="alert">
                    <i class="fa-solid fa-triangle-exclamation me-2"></i> @ViewBag.Fail
                </div>
            }

            @using (Html.BeginForm("Dangnhap", "User", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                <div class="form-floating mb-4">
                    @Html.EditorFor(model => model.userMail, new { htmlAttributes = new { @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Email" } })
                    @Html.LabelFor(model => model.userMail, "Email của bạn", new { @class = "text-muted" })
                    @Html.ValidationMessageFor(model => model.userMail, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <div class="form-floating mb-4">
                    @Html.EditorFor(model => model.password, new { htmlAttributes = new { type = "Password", @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Mật khẩu" } })
                    @Html.LabelFor(model => model.password, "Mật khẩu", new { @class = "text-muted" })
                    @Html.ValidationMessageFor(model => model.password, "", new { @class = "text-danger small mt-1 d-block" })
                </div>

                <button type="submit" class="btn btn-gradient w-100 py-3 mb-4 fs-5">Đăng nhập</button>

                <div class="text-center">
                    <span class="text-muted">Chưa có tài khoản?</span>
                    <a href="/User/Dangky" class="text-info text-decoration-none ms-1 hover-white fw-bold">Đăng ký ngay</a>
                </div>
            }
        </div>
    </div>
</div>
