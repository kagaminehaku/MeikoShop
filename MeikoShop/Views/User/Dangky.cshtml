@model MeikoShop.Models.Nguoidung

@{
    ViewBag.Title = "Đăng ký";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var useReg = Session["useReg"] as MeikoShop.Models.Nguoidung;
}

<div class="row justify-content-center align-items-center min-vh-100 py-5" style="margin-top: -40px;">
    <div class="col-md-8 col-lg-6">
        <div class="glass-card p-5">
            <div class="text-center mb-4">
                <i class="fa-solid fa-user-plus fa-3x text-gradient mb-3"></i>
                <h2 class="fw-bold text-white">Tạo tài khoản mới</h2>
                <p class="text-muted">Gia nhập cộng đồng người đam mê mô hình lớn nhất Việt Nam</p>
            </div>

            @if (ViewBag.RegOk != null)
            {
                <div class="alert alert-success bg-success bg-opacity-10 border-success text-success rounded-3 text-center mb-4" role="alert">
                    <i class="fa-solid fa-circle-check me-2"></i> @ViewBag.RegOk
                </div>
            }

            @if (ViewBag.isReg == true)
            {
                <div class="text-center">
                    <a href="/User/Dangnhap" class="btn btn-gradient px-5 py-3 fs-5">
                        <i class="fa-solid fa-right-to-bracket me-2"></i> Chuyển đến trang Đăng nhập
                    </a>
                </div>
            }
            else
            {
                using (Html.BeginForm("Dangky", "User", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.Hoten, new { htmlAttributes = new { @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Họ và tên" } })
                                @Html.LabelFor(model => model.Hoten, "Họ và tên", new { @class = "text-muted" })
                                @Html.ValidationMessageFor(model => model.Hoten, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                @Html.EditorFor(model => model.Dienthoai, new { htmlAttributes = new { @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Số điện thoại" } })
                                @Html.LabelFor(model => model.Dienthoai, "Số điện thoại", new { @class = "text-muted" })
                                @Html.ValidationMessageFor(model => model.Dienthoai, "", new { @class = "text-danger small mt-1 d-block" })
                            </div>
                        </div>
                    </div>

                    <div class="form-floating mb-4">
                        @Html.EditorFor(model => model.Email, new { htmlAttributes = new { @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Email" } })
                        @Html.LabelFor(model => model.Email, "Địa chỉ Email", new { @class = "text-muted" })
                        @Html.ValidationMessageFor(model => model.Email, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="form-floating mb-4">
                        @Html.EditorFor(model => model.Matkhau, new { htmlAttributes = new { type = "Password", @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Mật khẩu" } })
                        @Html.LabelFor(model => model.Matkhau, "Mật khẩu", new { @class = "text-muted" })
                        @Html.ValidationMessageFor(model => model.Matkhau, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <div class="form-floating mb-4">
                        @Html.EditorFor(model => model.Diachi, new { htmlAttributes = new { @class = "form-control bg-transparent text-white border-secondary", @placeholder = "Địa chỉ nhận hàng" } })
                        @Html.LabelFor(model => model.Diachi, "Địa chỉ nhận hàng", new { @class = "text-muted" })
                        @Html.ValidationMessageFor(model => model.Diachi, "", new { @class = "text-danger small mt-1 d-block" })
                    </div>

                    <button type="submit" class="btn btn-gradient w-100 py-3 mb-4 fs-5">Đăng ký ngay</button>

                    <div class="text-center">
                        <span class="text-muted">Đã có tài khoản?</span>
                        <a href="/User/Dangnhap" class="text-info text-decoration-none ms-1 hover-white fw-bold">Đăng nhập</a>
                    </div>
                }
            }
        </div>
    </div>
</div>
